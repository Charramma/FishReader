{
  "name": "fishreader",
  "version": "0.1.4",
  "description": "上班摸鱼看小说的 PC 迷你阅读器",
  "private": true,
  "main": "src/main/main.js",
  "author": "FishReader",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "dependencies": {
    "fast-xml-parser": "^4.5.7",
    "iconv-lite": "^0.6.3",
    "jschardet": "^3.1.4",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.fishreader.app",
    "productName": "FishReader",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "icon": "src/assets/icon.ico",
      "target": [
        "portable"
      ],
      "signAndEditExecutable": true
    },
    "portable": {
      "artifactName": "FishReader-${version}-portable.${ext}"
    }
  }
}
